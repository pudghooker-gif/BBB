{
  "info": {
    "_postman_id": "5a3c3fc1-0c4b-4e1d-9a0c-bbb-b2b-api",
    "name": "BBB B2B Aggregator API",
    "description": "Verified B2B API MVP collection. Set baseUrl, operatorId, apiKey, and operatorSecret variables before calling protected endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const operatorId = pm.variables.get('operatorId');",
          "const apiKey = pm.variables.get('apiKey');",
          "const secret = pm.variables.get('operatorSecret');",
          "if (!operatorId || !apiKey || !secret) {",
          "  console.warn('B2B HMAC variables are not set. Protected requests will fail until operatorId, apiKey, and operatorSecret are configured.');",
          "  return;",
          "}",
          "let rawBody = '';",
          "if (pm.request.body && pm.request.body.mode === 'raw' && pm.request.body.raw) {",
          "  rawBody = pm.variables.replaceIn(pm.request.body.raw);",
          "}",
          "const bodyHash = CryptoJS.SHA256(rawBody).toString(CryptoJS.enc.Hex);",
          "const timestamp = Math.floor(Date.now() / 1000).toString();",
          "const nonce = `${timestamp}-${pm.variables.replaceIn('{{$guid}}')}`;",
          "const path = '/' + pm.request.url.path.map(segment => pm.variables.replaceIn(segment)).join('/');",
          "const queryPairs = pm.request.url.query.all()",
          "  .filter(item => !item.disabled && item.key)",
          "  .map(item => [pm.variables.replaceIn(item.key), pm.variables.replaceIn(item.value || '')])",
          "  .sort((left, right) => left[0].localeCompare(right[0]))",
          "  .map(pair => `${encodeURIComponent(pair[0])}=${encodeURIComponent(pair[1])}`);",
          "const canonical = [pm.request.method.toUpperCase(), path, queryPairs.join('&'), bodyHash, timestamp, nonce].join('\\n');",
          "const signature = CryptoJS.HmacSHA256(canonical, secret).toString(CryptoJS.enc.Hex);",
          "pm.request.headers.upsert({ key: 'X-Operator-Id', value: operatorId });",
          "pm.request.headers.upsert({ key: 'X-Api-Key', value: apiKey });",
          "pm.request.headers.upsert({ key: 'X-Timestamp', value: timestamp });",
          "pm.request.headers.upsert({ key: 'X-Nonce', value: nonce });",
          "pm.request.headers.upsert({ key: 'X-Body-Hash', value: bodyHash });",
          "pm.request.headers.upsert({ key: 'X-Signature', value: signature });",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
