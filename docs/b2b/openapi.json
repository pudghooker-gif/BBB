{
  "openapi": "3.1.0",
  "info": {
    "title": "BBB B2B Aggregator API",
    "version": "1.0.0",
    "description": "Verified MVP contract for the signed B2B API. All protected endpoints use HMAC headers documented in docs/api/HMAC_AUTHENTICATION.md."
  },
  "servers": [
    {
      "url": "{baseUrl}/api/b2b/v1",
      "variables": {
        "baseUrl": {
          "default": "https://operator-api.example"
        }
      }
    }
  ],
  "tags": [
    { "name": "health" },
    { "name": "operator" },
    { "name": "portal" },
    { "name": "games" },
    { "name": "sessions" },
    { "name": "wallet" },
    { "name": "reports" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Public B2B health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Service health envelope",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiSuccess" }
              }
            }
          }
        }
      }
    },
    "/readiness": {
      "get": {
        "tags": ["health"],
        "summary": "Public B2B readiness check for runtime dependencies",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is ready",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiSuccess" }
              }
            }
          },
          "503": {
            "description": "Service is not ready",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["health"],
        "summary": "Prometheus-compatible aggregate B2B metrics",
        "description": "Exports aggregate service, session, wallet, reconciliation, settlement, provider, and queue metrics without operator identifiers or payload data. Restrict this endpoint at the edge in production.",
        "security": [],
        "responses": {
          "200": {
            "description": "Prometheus text exposition format",
            "content": {
              "text/plain; version=0.0.4": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/operator/me": {
      "get": {
        "tags": ["operator"],
        "summary": "Return signed operator profile and operational counters",
        "security": [{ "B2BHmac": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/portal": {
      "get": {
        "tags": ["portal"],
        "summary": "Render the signed read-only operator portal page",
        "description": "Returns an HTML operator portal for the signed operator using the same tenant-scoped, redacted data as /portal/overview.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-01" },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-24" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50 }, "example": 10 }
        ],
        "responses": {
          "200": {
            "description": "Tenant-scoped operator portal HTML",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/portal/overview": {
      "get": {
        "tags": ["portal"],
        "summary": "Return a tenant-scoped read-only operator portal overview",
        "description": "Aggregates signed-operator profile, API key status, wallet/session/reporting summaries, recent sessions, recent transactions, settlements, reconciliation items, and safe navigation links. Secret material and raw wallet payloads are never returned.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-01" },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-24" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50 }, "example": 10 }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/portal/credentials": { "$ref": "#/components/pathItems/PortalPage" },
    "/portal/games": { "$ref": "#/components/pathItems/PortalPage" },
    "/portal/sessions": { "$ref": "#/components/pathItems/PortalPage" },
    "/portal/transactions": { "$ref": "#/components/pathItems/PortalPage" },
    "/portal/settlements": { "$ref": "#/components/pathItems/PortalPage" },
    "/portal/cases": { "$ref": "#/components/pathItems/PortalPage" },
    "/portal/callbacks": { "$ref": "#/components/pathItems/PortalPage" },
    "/portal/reports": { "$ref": "#/components/pathItems/PortalPage" },
    "/portal/support": { "$ref": "#/components/pathItems/PortalPage" },
    "/portal/support/cases/{transaction_uid}/comments": {
      "post": {
        "tags": ["portal"],
        "summary": "Add an operator-visible support comment to an open case",
        "description": "Appends a signed operator comment to the operator's own open or in-progress reconciliation case. The comment is redacted before persistence, writes a B2B audit event, and never changes wallet state or settlement data.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "name": "transaction_uid", "in": "path", "required": true, "schema": { "type": "string" }, "example": "tx_123" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string", "maxLength": 1000 },
                  "external_reference": { "type": "string", "maxLength": 120 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/portal/support/tickets": {
      "post": {
        "tags": ["portal"],
        "summary": "Create an operator support ticket",
        "description": "Creates a tenant-scoped support ticket from the signed operator portal. Subject, message, metadata, and audit reason are redacted before persistence.",
        "security": [{ "B2BHmac": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["subject", "message"],
                "properties": {
                  "subject": { "type": "string", "maxLength": 160 },
                  "message": { "type": "string", "maxLength": 2000 },
                  "priority": { "type": "string", "enum": ["low", "normal", "high", "urgent"], "default": "normal" },
                  "category": { "type": "string", "maxLength": 80 },
                  "external_reference": { "type": "string", "maxLength": 120 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/portal/support/tickets/{ticket_uid}/comments": {
      "post": {
        "tags": ["portal"],
        "summary": "Add an operator support ticket comment",
        "description": "Appends a redacted operator message to the signed operator's own open or in-progress support ticket and writes a support_ticket.operator_commented audit event.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "name": "ticket_uid", "in": "path", "required": true, "schema": { "type": "string" }, "example": "sup_abc123" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string", "maxLength": 2000 },
                  "external_reference": { "type": "string", "maxLength": 120 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/portal/support/tickets/{ticket_uid}/close": {
      "post": {
        "tags": ["portal"],
        "summary": "Close an operator support ticket",
        "description": "Closes the signed operator's own open or in-progress support ticket, stores the redacted close reason, and writes a support_ticket.closed audit event.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "name": "ticket_uid", "in": "path", "required": true, "schema": { "type": "string" }, "example": "sup_abc123" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reason"],
                "properties": {
                  "reason": { "type": "string", "maxLength": 1000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/portal/docs": { "$ref": "#/components/pathItems/PortalPage" },
    "/games": {
      "get": {
        "tags": ["games"],
        "summary": "List games available to the signed operator",
        "description": "Returns a bounded signed-operator game catalog. Results pass through the same assignment, shop, currency, country, and mode availability checks used by launch.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }, "example": 50 },
          { "name": "provider", "in": "query", "schema": { "type": "string", "maxLength": 80 }, "example": "external_provider" },
          { "name": "category", "in": "query", "schema": { "type": "string", "maxLength": 80 }, "example": "slots" },
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 120 }, "example": "book" },
          { "name": "currency", "in": "query", "schema": { "type": "string", "minLength": 3, "maxLength": 3 }, "example": "USD" },
          { "name": "country", "in": "query", "schema": { "type": "string", "minLength": 2, "maxLength": 2 }, "example": "BR" },
          { "name": "mode", "in": "query", "schema": { "type": "string", "enum": ["real", "demo"], "default": "real" }, "example": "real" },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["title", "-title", "provider", "-provider", "category", "-category", "game_uid", "-game_uid"] }, "example": "title" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/games/{game_uid}": {
      "get": {
        "tags": ["games"],
        "summary": "Return one game available to the signed operator",
        "description": "Returns a single active catalog or legacy Goldsvet game after the same operator assignment, shop, currency, country, and mode checks used by launch.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/GameUid" },
          { "name": "currency", "in": "query", "schema": { "type": "string", "minLength": 3, "maxLength": 3 }, "example": "USD" },
          { "name": "country", "in": "query", "schema": { "type": "string", "minLength": 2, "maxLength": 2 }, "example": "BR" },
          { "name": "mode", "in": "query", "schema": { "type": "string", "enum": ["real", "demo"] }, "example": "real" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/games/launch": {
      "post": {
        "tags": ["games"],
        "summary": "Create a B2B game session and return a public launch URL",
        "security": [{ "B2BHmac": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LaunchRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sessions": {
      "get": {
        "tags": ["sessions"],
        "summary": "List sessions for the signed operator",
        "description": "Returns a bounded tenant-scoped session list with validated filters and whitelisted sorting.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }, "example": 100 },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["active", "stale", "expired", "closed", "failed"] }, "example": "active" },
          { "name": "player_id", "in": "query", "schema": { "type": "string", "maxLength": 191 }, "example": "player_123" },
          { "name": "game_id", "in": "query", "schema": { "type": "string", "maxLength": 191 }, "example": "bookofdead" },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["created_at", "-created_at", "updated_at", "-updated_at", "expires_at", "-expires_at", "status", "-status", "game_id", "-game_id", "session_uid", "-session_uid"], "default": "-created_at" }, "example": "-created_at" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sessions/{session_uid}": {
      "get": {
        "tags": ["sessions"],
        "summary": "Return one operator-owned session and recent wallet transactions",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/SessionUid" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/sessions/{session_uid}/close": {
      "post": {
        "tags": ["sessions"],
        "summary": "Close an operator-owned session through the provider close contract",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/SessionUid" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SessionCloseRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "501": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/wallet/health": {
      "get": {
        "tags": ["wallet"],
        "summary": "Return wallet callback and circuit-breaker health for the signed operator",
        "security": [{ "B2BHmac": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/wallet/balance": {
      "post": {
        "tags": ["wallet"],
        "summary": "Forward a balance request to the operator wallet",
        "security": [{ "B2BHmac": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WalletBalanceRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "422": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/wallet/bet": { "$ref": "#/components/pathItems/WalletMutation" },
    "/wallet/win": { "$ref": "#/components/pathItems/WalletMutation" },
    "/wallet/refund": { "$ref": "#/components/pathItems/WalletMutation" },
    "/wallet/rollback": { "$ref": "#/components/pathItems/WalletMutation" },
    "/wallet/transactions/{transaction_uid}/status": {
      "get": {
        "tags": ["wallet"],
        "summary": "Return operator-scoped wallet transaction status and operational history",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TransactionUid" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/wallet/transactions/{transaction_uid}/attempts": {
      "get": {
        "tags": ["wallet"],
        "summary": "Return recent callback attempts for an operator-scoped transaction UID",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TransactionUid" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/reports/summary": { "$ref": "#/components/pathItems/ReportCollection" },
    "/reports/transactions": {
      "get": {
        "tags": ["reports"],
        "summary": "List wallet transactions for the signed operator",
        "description": "Returns a bounded tenant-scoped transaction list with validated filters, currency separation, and whitelisted sorting.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-01" },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-24" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }, "example": 100 },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "accepted", "rejected", "success", "failed", "timeout", "unknown", "rollback_required", "reversed", "manual_review", "dead_letter"] }, "example": "success" },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["balance", "bet", "win", "refund", "rollback"] }, "example": "bet" },
          { "name": "player_id", "in": "query", "schema": { "type": "string", "maxLength": 191 }, "example": "player_123" },
          { "name": "game_id", "in": "query", "schema": { "type": "string", "maxLength": 191 }, "example": "bookofdead" },
          { "name": "round_id", "in": "query", "schema": { "type": "string", "maxLength": 191 }, "example": "round_001" },
          { "name": "currency", "in": "query", "schema": { "type": "string", "minLength": 3, "maxLength": 3 }, "example": "USD" },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["created_at", "-created_at", "amount", "-amount", "type", "-type", "status", "-status", "currency", "-currency", "game_id", "-game_id", "transaction_uid", "-transaction_uid"], "default": "-created_at" }, "example": "-created_at" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/reports/ggr": { "$ref": "#/components/pathItems/ReportCollection" },
    "/reports/settlements": {
      "get": {
        "tags": ["reports"],
        "summary": "List settlements for the signed operator",
        "description": "Returns a bounded tenant-scoped settlement list with validated filters and whitelisted sorting.",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-01" },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-24" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }, "example": 100 },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["draft", "exported", "submitted", "approved", "rejected"] }, "example": "exported" },
          { "name": "currency", "in": "query", "schema": { "type": "string", "minLength": 3, "maxLength": 3 }, "example": "USD" },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["created_at", "-created_at", "period_start", "-period_start", "period_end", "-period_end", "status", "-status", "currency", "-currency", "net_amount", "-net_amount", "settlement_uid", "-settlement_uid"], "default": "-created_at" }, "example": "-created_at" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/reports/settlements/export": {
      "post": {
        "tags": ["reports"],
        "summary": "Generate or return an operator-scoped settlement export snapshot",
        "security": [{ "B2BHmac": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SettlementExportRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "422": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/reports/settlements/{settlement_uid}": {
      "get": {
        "tags": ["reports"],
        "summary": "Return one operator-scoped settlement snapshot and lifecycle state",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/SettlementUid" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/reports/reconciliation": { "$ref": "#/components/pathItems/ReportCollection" },
    "/reports/transactions/{transaction_uid}": {
      "get": {
        "tags": ["reports"],
        "summary": "Return one operator-scoped wallet transaction with logs and status history",
        "security": [{ "B2BHmac": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TransactionUid" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "B2BHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Signature",
        "description": "Protected endpoints also require X-Operator-Id, X-Api-Key, X-Timestamp, X-Nonce, and X-Body-Hash. Signature payload is METHOD, path, canonical query, body hash, timestamp, nonce joined by newlines."
      }
    },
    "parameters": {
      "SessionUid": {
        "name": "session_uid",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "maxLength": 191 },
        "example": "sess_xxx"
      },
      "GameUid": {
        "name": "game_uid",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "maxLength": 191 },
        "example": "bookofdead"
      },
      "TransactionUid": {
        "name": "transaction_uid",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "maxLength": 191 },
        "example": "bet_001"
      },
      "SettlementUid": {
        "name": "settlement_uid",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "maxLength": 80 },
        "example": "stl_abc123"
      }
    },
    "pathItems": {
      "WalletMutation": {
        "post": {
          "tags": ["wallet"],
          "summary": "Forward a wallet mutation to the operator wallet",
          "security": [{ "B2BHmac": [] }],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletMutationRequest" }
              }
            }
          },
          "responses": {
            "200": { "$ref": "#/components/responses/Success" },
            "404": { "$ref": "#/components/responses/Error" },
            "409": { "$ref": "#/components/responses/Error" },
            "422": { "$ref": "#/components/responses/Error" },
            "502": { "$ref": "#/components/responses/Error" }
          }
        }
      },
      "PortalPage": {
        "get": {
          "tags": ["portal"],
          "summary": "Render a signed read-only operator portal workflow page",
          "description": "Returns tenant-scoped HTML for credentials, games, sessions, transactions, settlements, cases, or docs without secret material or raw wallet payloads.",
          "security": [{ "B2BHmac": [] }],
          "parameters": [
            { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-01" },
            { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-24" },
            { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50 }, "example": 10 }
          ],
          "responses": {
            "200": {
              "description": "Tenant-scoped operator portal workflow HTML",
              "content": {
                "text/html": {
                  "schema": { "type": "string" }
                }
              }
            },
            "401": { "$ref": "#/components/responses/Error" }
          }
        }
      },
      "ReportCollection": {
        "get": {
          "tags": ["reports"],
          "summary": "Return operator-scoped report data",
          "security": [{ "B2BHmac": [] }],
          "parameters": [
            { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-01" },
            { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" }, "example": "2026-06-24" },
            { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000 }, "example": 100 },
            { "name": "game_id", "in": "query", "schema": { "type": "string" }, "example": "bookofdead" },
            { "name": "currency", "in": "query", "schema": { "type": "string", "minLength": 3, "maxLength": 3 }, "example": "USD" }
          ],
          "responses": {
            "200": { "$ref": "#/components/responses/Success" },
            "401": { "$ref": "#/components/responses/Error" }
          }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Standard success envelope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiSuccess" }
          }
        }
      },
      "Error": {
        "description": "Standard error envelope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      }
    },
    "schemas": {
      "ApiSuccess": {
        "type": "object",
        "required": ["success", "status", "request_id", "data"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "status": { "type": "string", "example": "success" },
          "request_id": { "type": "string", "example": "uuid-or-client-request-id" },
          "data": { "type": "object", "additionalProperties": true },
          "meta": { "type": "object", "additionalProperties": true }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["success", "status", "request_id", "error"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "status": { "type": "string", "example": "error" },
          "request_id": { "type": "string", "example": "uuid-or-client-request-id" },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_FAILED" },
              "message": { "type": "string", "example": "Request validation failed." },
              "details": { "type": "object", "additionalProperties": true }
            }
          },
          "meta": { "type": "object", "additionalProperties": true }
        }
      },
      "LaunchRequest": {
        "type": "object",
        "required": ["player_id", "game_id", "currency"],
        "properties": {
          "player_id": { "type": "string", "maxLength": 191, "example": "player_123" },
          "game_id": { "type": "string", "maxLength": 191, "example": "bookofdead" },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3, "example": "USD" },
          "language": { "type": "string", "maxLength": 8, "example": "en" },
          "country": { "type": "string", "minLength": 2, "maxLength": 2, "example": "BR" },
          "mode": { "type": "string", "enum": ["real", "demo"], "example": "real" },
          "return_url": { "type": "string", "format": "uri", "example": "https://operator.example/casino" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "SessionCloseRequest": {
        "type": "object",
        "properties": {
          "reason": { "type": "string", "maxLength": 100, "example": "player_logout" }
        }
      },
      "SettlementExportRequest": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "format": "date", "example": "2026-06-01" },
          "to": { "type": "string", "format": "date", "example": "2026-06-30" },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3, "example": "USD" },
          "format": { "type": "string", "enum": ["csv", "json"], "example": "csv" }
        }
      },
      "WalletBalanceRequest": {
        "type": "object",
        "required": ["player_id", "currency"],
        "properties": {
          "player_id": { "type": "string", "maxLength": 191, "example": "player_123" },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3, "example": "USD" },
          "provider": { "type": "string", "maxLength": 191, "example": "goldsvet_internal" },
          "game_id": { "type": "string", "maxLength": 191, "example": "bookofdead" },
          "session_id": { "type": "string", "maxLength": 191, "example": "sess_xxx" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "WalletMutationRequest": {
        "type": "object",
        "required": ["player_id", "game_id", "session_id", "round_id", "transaction_id", "amount", "currency"],
        "properties": {
          "player_id": { "type": "string", "maxLength": 191, "example": "player_123" },
          "game_id": { "type": "string", "maxLength": 191, "example": "bookofdead" },
          "provider": { "type": "string", "maxLength": 191, "example": "goldsvet_internal" },
          "session_id": { "type": "string", "maxLength": 191, "example": "sess_xxx" },
          "round_id": { "type": "string", "maxLength": 191, "example": "round_001" },
          "transaction_id": { "type": "string", "maxLength": 191, "example": "bet_001" },
          "original_transaction_id": { "type": "string", "maxLength": 191, "example": "bet_001" },
          "amount": { "type": "string", "pattern": "^\\d{1,12}(\\.\\d{1,8})?$", "example": "10.00000000" },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3, "example": "USD" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}
