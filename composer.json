{
    "name": "loshmis/vanguard",
    "description": "Advanced PHP Login and User Management",
    "license": "proprietary",
    "keywords": ["advanced", "secure", "login", "user management", "authentication", "authorization", "register"],
    "type": "project",
    "repositories": [],
    "require": {
        "php": "^7.4",
        "anlutro/l4-settings": "^1.0",
        "bacon/bacon-qr-code": "^2.0",
        "geoip2/geoip2": "^2.11",
        "guzzlehttp/guzzle": "^7.12",
        "hexters/coinpayment": "^2.0",
        "intervention/image": "^2.3",
        "jenssegers/agent": "^2.5",
        "jeremykenedy/laravel-roles": "3.*",
        "laracasts/presenter": "^0.2.1",
        "laravel/framework": "^8.83.29",
        "laravel/legacy-factories": "^1.0",
        "laravel/tinker": "^2.0",
        "laravelcollective/html": "^6.0",
        "league/fractal": "^0.16.0",
        "mobiledetect/mobiledetectlib": "^2.8",
        "pragmarx/google2fa-laravel": "^1.4",
        "predis/predis": "^1.1",
        "proengsoft/laravel-jsvalidation": "^4.0",
        "spatie/db-dumper": "^2.21",
        "tymon/jwt-auth": "1.*",
        "yajra/laravel-datatables-oracle": "~9.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "filp/whoops": "^2.0",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^4.1",
        "phpunit/phpunit": "^8.5.52"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "VanguardLTE\\": "app/"
        },
        "exclude-from-classmap": [
            "app/Games/AmazingSevensGT/AtTheMoviesBS/",
            "app/Games/AmazingSevensGT/BookOfDarknessBS/",
            "app/Games/AmazingSevensGT/DimSumPrizeBS/",
            "app/Games/AmazingSevensGT/GoldenHornsBS/",
            "app/Games/AmazingSevensGT/Lucky7BS/",
            "app/Games/AmazingSevensGT/PrimalHuntBS/",
            "app/Games/AmazingSevensGT/QuestToTheWestBS/",
            "app/Games/AmazingSevensGT/SpringTailsBS/",
            "app/Games/AmazingSevensGT/SushiBarBS/",
            "app/Games/AmazingSevensGT/WolfMoonRisingBS/",
            "app/Http/Controllers/Web/Backend/ShopsController_original.php",
            "app/Jobs/CoinpaymentListener.php"
        ],
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],

        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
