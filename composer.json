{
    "name": "loshmis/vanguard",
    "description": "Advanced PHP Login and User Management",
    "license": "proprietary",
    "keywords": ["advanced", "secure", "login", "user management", "authentication", "authorization", "register"],
    "type": "project",
    "repositories": [],
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^2.0",
        "geoip2/geoip2": "^2.11",
        "guzzlehttp/guzzle": "^7.12",
        "hexters/coinpayment": "^2.0",
        "intervention/image": "^2.3",
        "jenssegers/agent": "^2.5",
        "laravel/framework": "^12.61.1",
        "laravel/tinker": "^2.0",
        "league/fractal": "^0.16.0",
        "mobiledetect/mobiledetectlib": "^2.8",
        "pragmarx/google2fa-qrcode": "^1.0",
        "predis/predis": "^1.1",
        "spatie/db-dumper": "^4.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "filp/whoops": "^2.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "classmap": [
            "database/seeds"
        ],
        "psr-4": {
            "Tymon\\JWTAuth\\": "app/Support/Jwt/Tymon/",
            "VanguardLTE\\": "app/"
        },
        "exclude-from-classmap": [
            "app/Games/AmazingSevensGT/AtTheMoviesBS/",
            "app/Games/AmazingSevensGT/BookOfDarknessBS/",
            "app/Games/AmazingSevensGT/DimSumPrizeBS/",
            "app/Games/AmazingSevensGT/GoldenHornsBS/",
            "app/Games/AmazingSevensGT/Lucky7BS/",
            "app/Games/AmazingSevensGT/PrimalHuntBS/",
            "app/Games/AmazingSevensGT/QuestToTheWestBS/",
            "app/Games/AmazingSevensGT/SpringTailsBS/",
            "app/Games/AmazingSevensGT/SushiBarBS/",
            "app/Games/AmazingSevensGT/WolfMoonRisingBS/",
            "app/Http/Controllers/Web/Backend/ShopsController_original.php",
            "app/Jobs/CoinpaymentListener.php"
        ],
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],

        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
