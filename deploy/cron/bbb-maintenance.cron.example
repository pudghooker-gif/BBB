# Optional cron fallback when systemd timers are not available.
# Prefer deploy/systemd/bbb-scheduler.timer on production Linux hosts.

* * * * * www-data cd /var/www/bbb/current && /usr/bin/php artisan schedule:run --no-interaction >> /var/log/bbb/scheduler.log 2>&1
*/5 * * * * www-data cd /var/www/bbb/current && /usr/bin/php artisan b2b:reconcile-wallet --limit=100 >> /var/log/bbb/b2b-reconcile.log 2>&1
0 3 * * * root /usr/bin/env bash /var/www/bbb/current/deploy/scripts/backup.sh >> /var/log/bbb/backup.log 2>&1
