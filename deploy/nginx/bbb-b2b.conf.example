# Example Nginx virtual host for BBB B2B production.
# Copy to /etc/nginx/sites-available/bbb-b2b.conf and replace domains/paths.

upstream bbb_b2b_php {
    server unix:/run/php/php7.4-fpm-bbb.sock;
}

server {
    listen 80;
    server_name b2b.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name b2b.example.com;

    root /var/www/bbb/current/public;
    index index.php;

    ssl_certificate /etc/letsencrypt/live/b2b.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/b2b.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:20m;
    ssl_session_timeout 1d;

    client_max_body_size 10m;
    keepalive_timeout 15;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;

    access_log /var/log/nginx/bbb-b2b.access.log;
    error_log /var/log/nginx/bbb-b2b.error.log warn;

    location = /healthz {
        rewrite ^ /api/b2b/v1/health last;
    }

    location = /readyz {
        rewrite ^ /api/b2b/v1/readiness last;
    }

    location = /metrics {
        # Restrict this endpoint to the monitoring network on the final host.
        rewrite ^ /api/b2b/v1/metrics last;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~* \.(?:env|sql|bak|backup|old|key|crt|pem|log)$ {
        deny all;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass bbb_b2b_php;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_read_timeout 60s;
        fastcgi_send_timeout 60s;
        fastcgi_buffering on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|ico|woff|woff2|ttf|eot)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }
}
